// Contournement local : `Bouton` n'a pas de largeur préférée issue de son texte, il s'écrase ou s'étire selon la mise en page.
// Ces enveloppes mesurent le texte et donnent une largeur explicite.
import { Theme } from "../theme.slint";
import { Bouton, GenreBouton } from "../composants.slint";

export component BoutonAuto inherits Rectangle {
    in property <string> texte;
    in property <GenreBouton> genre: GenreBouton.secondaire;
    in property <bool> actif: true;
    in property <string> prefixe: "";
    callback active();
    width: mesure.preferred-width + 48px + (prefixe != "" ? 24px : 0px) + (genre == GenreBouton.principal ? texte.character-count * 2.5px : 0px);
    height: Theme.cible;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    mesure := Text {
        visible: false;
        text: genre == GenreBouton.principal ? texte.to-uppercase() : texte;
        font-family: Theme.courant;
        font-weight: 700;
        font-size: 15px;
    }
    Bouton {
        width: parent.width;
        height: parent.height;
        texte: root.texte;
        genre: root.genre;
        actif: root.actif;
        prefixe: root.prefixe;
        active => { root.active(); }
    }
}

export component ChoixAuto inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> choisi;
    callback choisit(int);
    spacing: 8px;
    alignment: end;
    for option[i] in options: BoutonAuto {
        texte: option;
        genre: i == choisi ? GenreBouton.choisi : GenreBouton.secondaire;
        active => { root.choisit(i); }
    }
}
