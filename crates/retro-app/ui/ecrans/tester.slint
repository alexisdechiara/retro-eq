import { Theme } from "../theme.slint";
import { Test, Appli, Ecran, LigneMode } from "../etat.slint";
import { Titre, TitreSection, Etiquette, Paragraphe, Chiffres, Bouton, GenreBouton, Carte, Pastille, Touche } from "../composants.slint";

// Une bobine de cassette : couronne claire, moyeu sombre.
component Bobine inherits Rectangle {
    in property <length> taille: 26px;
    width: taille;
    height: taille;
    border-radius: taille / 2;
    background: Theme.texte;
    Rectangle {
        width: parent.width * 0.5;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.fond;
        for angle in [0, 60, 120, 180, 240, 300]: Rectangle {
            property <angle> a: angle * 1deg;
            x: parent.width / 2 + cos(a) * parent.width * 0.3 - 1.5px;
            y: parent.height / 2 + sin(a) * parent.width * 0.3 - 1.5px;
            width: 3px;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.texte;
        }
    }
}

// Une cassette dessinée comme un objet : coque, étiquette, bande de couleur, fenêtre à deux bobines.
// Avec `legende`, le nom, la description et la source sont écrits sous la coque.
component Cassette inherits VerticalLayout {
    in property <length> haut: 200px;       // hauteur de la coque
    in property <color> teinte: Theme.a;
    in property <string> nom;
    in property <string> description;
    in property <string> source;
    in property <string> resume;
    in property <bool> disponible: true;
    in property <bool> choisie: false;
    in property <bool> legende: true;
    callback choisir();
    spacing: 12px;
    min-width: 0px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: disponible ? nom : @tr("{} (bientôt disponible)", nom);
    accessible-enabled: disponible;
    accessible-action-default => { if (disponible) { root.choisir(); } }

    cadre := Rectangle {
        height: haut;
        vertical-stretch: 0;
        coque := Rectangle {
            property <length> larg: self.width;
            x: 0px;
            width: min(parent.width, haut * 1.62);
            height: parent.height;
            border-radius: 14px;
            background: disponible ? teinte.mix(Theme.fond, 0.35) : Theme.surface;
            border-width: choisie ? 3px : 1.5px;
            border-color: choisie ? Theme.ambre : Theme.trait;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #000000a0;
            for p in [{ x: 0.0, y: 0.0 }, { x: 1.0, y: 0.0 }, { x: 0.0, y: 1.0 }, { x: 1.0, y: 1.0 }]: Rectangle {
                x: 8px + p.x * (parent.width - 24px);
                y: 8px + p.y * (parent.height - 24px);
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.fond;
            }
            Path {
                x: parent.width * 0.2;
                y: parent.height * 0.77;
                width: parent.width * 0.6;
                height: parent.height * 0.21;
                viewbox-width: 100;
                viewbox-height: 40;
                fill: Theme.fond.with-alpha(0.55);
                MoveTo { x: 0; y: 40; }
                LineTo { x: 12; y: 0; }
                LineTo { x: 88; y: 0; }
                LineTo { x: 100; y: 40; }
                Close { }
            }
            for dx in [0.36, 0.43, 0.57, 0.64]: Rectangle {
                x: parent.width * dx - 4px;
                y: parent.height * 0.87;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.fond;
            }
            Rectangle {
                x: parent.width * 0.07;
                y: parent.height * 0.09;
                width: parent.width * 0.86;
                height: parent.height * 0.68;
                border-radius: 6px;
                background: disponible ? Theme.texte : Theme.discret;
                clip: true;
                VerticalLayout {
                    Rectangle {
                        height: max(18px, coque.larg * 0.075);
                        background: disponible ? teinte : Theme.trait;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text { text: @tr("FACE A"); font-family: Theme.chiffres; font-size: max(9px, coque.larg * 0.034); color: Theme.fond; vertical-alignment: center; }
                            Rectangle { }
                            Text { text: "RETRO EQ"; font-family: Theme.chiffres; font-size: max(9px, coque.larg * 0.034); color: Theme.fond; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                    Text {
                        text: nom.to-uppercase();
                        font-family: Theme.titres;
                        font-weight: 700;
                        font-size: max(15px, coque.larg * 0.075);
                        color: Theme.fond;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                    }
                    Rectangle {
                        Rectangle {
                            width: min(parent.width * 0.62, 190px);
                            height: min(parent.height, 40px);
                            border-radius: self.height / 2;
                            background: Theme.fond;
                            Bobine { x: parent.width * 0.2 - self.width / 2; y: (parent.height - self.height) / 2; taille: parent.height * 0.76; }
                            Bobine { x: parent.width * 0.8 - self.width / 2; y: (parent.height - self.height) / 2; taille: parent.height * 0.76; }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        height: max(24px, coque.larg * 0.08);
                    Text {
                        text: resume;
                        font-family: Theme.chiffres;
                        font-size: max(10px, coque.larg * 0.036);
                        color: Theme.fond;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                    }
                }
            }
            if !disponible: Rectangle {
                border-radius: 14px;
                background: Theme.fond.with-alpha(0.45);
            }
            TouchArea {
                enabled: disponible;
                mouse-cursor: disponible ? MouseCursor.pointer : MouseCursor.default;
                clicked => { portee.focus(); root.choisir(); }
            }
            // `focus-on-click: false` : voir le commentaire de `Bouton` (composants.slint).
            portee := FocusScope {
        // L'anneau de focus ne s'affiche qu'en navigation au clavier (Tab), pas après un clic
        // (sinon il recouvrait la barre ambre de l'onglet actif : constaté sur le PC, 25/11/2026).
        property <bool> au-clavier;
        focus-gained(raison) => { self.au-clavier = raison == FocusReason.tab-navigation; }
                focus-on-click: false;
                enabled: disponible;
                key-pressed(e) => {
                    if (e.text == " " || e.text == Key.Return) { root.choisir(); return accept; }
                    return reject;
                }
            }
            if (portee.has-focus && portee.au-clavier): Rectangle {
                x: -6px;
                y: -6px;
                width: parent.width + 12px;
                height: parent.height + 12px;
                border-radius: 20px;
                border-width: 3px;
                border-color: Theme.jaune;
            }
        }
    }
    if legende: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text { text: nom; font-family: Theme.courant; font-weight: 700; font-size: 16px; color: Theme.texte; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 0; }
            if choisie: Pastille { texte: @tr("Dans le lecteur"); couleur: Theme.ambre; encre: Theme.sur-ambre; taille: 13px; }
            if !disponible: Pastille { texte: @tr("Bientôt"); taille: 13px; }
        }
        Text { text: description; font-family: Theme.courant; font-size: 14px; color: Theme.discret; wrap: word-wrap; }
        Text { text: source; font-family: Theme.chiffres; font-size: 12px; color: Theme.discret; wrap: word-wrap; }
    }
}

export component Tester inherits VerticalLayout {
    alignment: start;
    spacing: 0px;

    pure function teinte(id: string) -> color {
        return id == "duels-en-jeu" ? Theme.a
            : id == "parcours" ? Theme.ambre
            : id == "musique" ? Theme.b
            : id == "echantillons" ? Theme.ok
            : id == "une-zone" ? Theme.rouille
            : id == "profil-contre-profil" ? Theme.bleu
            : Theme.discret;
    }

    VerticalLayout {
        padding-bottom: 28px;
        spacing: 6px;
        Titre { contenu: @tr("Tester"); }
        Paragraphe { text: @tr("Choisis une cassette, glisse-la dans le lecteur. Chaque test cherche ta courbe d’une façon différente."); }
    }

    // Le lecteur : la cassette chargée, ses chiffres, le bouton Lancer.
    Carte {
        remplissage: 28px;
        HorizontalLayout {
            spacing: 36px;
            Rectangle {
                width: 410px;
                height: 300px;
                horizontal-stretch: 0;
                vertical-stretch: 0;
                border-radius: 20px;
                background: Theme.ecran;
                border-width: 1px;
                border-color: Theme.trait;
                for m in Test.modes: Cassette {
                    visible: m.id == Test.mode-choisi;
                    x: 15px;
                    y: 24px;
                    width: 380px;
                    haut: 235px;
                    legende: false;
                    teinte: root.teinte(m.id);
                    nom: m.nom;
                    resume: @tr("{} duels · {}", m.duels, m.duree);
                }
                Etiquette { x: 20px; y: parent.height - 30px; contenu: @tr("Dans le lecteur"); }
            }
            VerticalLayout {
                alignment: center;
                if Test.modes.length == 0: Paragraphe { text: @tr("Aucun test n’est disponible pour le moment."); }
                for m in Test.modes: VerticalLayout {
                    spacing: 14px;
                    if m.id == Test.mode-choisi: HorizontalLayout {
                        alignment: start;
                        spacing: 10px;
                        Pastille { texte: m.groupe; taille: 14px; }
                        Pastille { texte: @tr("Face A et B tirées au hasard"); taille: 14px; }
                    }
                    if m.id == Test.mode-choisi: Titre { contenu: m.nom; }
                    if m.id == Test.mode-choisi: Paragraphe { text: m.description; }
                    if m.id == Test.mode-choisi: HorizontalLayout {
                        spacing: 32px;
                        alignment: start;
                        for stat in [{ lib: @tr("Duels"), val: m.duels }, { lib: @tr("Durée"), val: m.duree }, { lib: @tr("Son"), val: m.source }]: VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 0;
                            Etiquette { contenu: stat.lib; font-size: 12px; }
                            Chiffres { text: stat.val; font-size: 22px; wrap: word-wrap; }
                        }
                    }
                    if m.id == Test.mode-choisi: HorizontalLayout {
                        alignment: start;
                        Bouton {
                            texte: @tr("Lancer");
                            prefixe: "▶";
                            genre: GenreBouton.principal;
                            actif: m.disponible;
                            active => { Appli.aller(Ecran.nouveau-test); }
                        }
                    }
                    if m.id == Test.mode-choisi: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: @tr("Ou lance-le de n’importe où :"); font-family: Theme.courant; font-size: 14px; color: Theme.discret; vertical-alignment: center; }
                        Touche { texte: "Ctrl"; }
                        Touche { texte: "Alt"; }
                        Touche { texte: @tr("Entrée"); }
                    }
                }
            }
        }
    }

    // Les étagères : une section par groupe, ouverte par le premier mode du groupe.
    for premier[i] in Test.modes: section := VerticalLayout {
        property <bool> ouvre: i == 0 || Test.modes[i - 1].groupe != premier.groupe;
        padding-top: ouvre ? 32px : 0px;
        spacing: 18px;
        if ouvre: TitreSection { contenu: premier.groupe; }
        if ouvre: HorizontalLayout {
            alignment: start;
            for m in Test.modes: HorizontalLayout {
                padding-right: m.groupe == premier.groupe ? 24px : 0px;
                preferred-width: m.groupe == premier.groupe ? 372px : 0px;
                max-width: m.groupe == premier.groupe ? 1000px : 0px;
                min-width: 0px;
                horizontal-stretch: m.groupe == premier.groupe ? 1 : 0;
                if m.groupe == premier.groupe: Cassette {
                    haut: 215px;
                    teinte: root.teinte(m.id);
                    nom: m.nom;
                    description: m.description;
                    source: m.source;
                    resume: m.duels == "—" ? m.duree : @tr("{} duels · {}", m.duels, m.duree);
                    disponible: m.disponible;
                    choisie: m.id == Test.mode-choisi;
                    choisir => { Test.mode-choisi = m.id; }
                }
            }
        }
        if ouvre: Rectangle { height: 8px; border-radius: 4px; background: Theme.doux; }
    }
}
