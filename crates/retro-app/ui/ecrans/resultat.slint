import { Theme } from "../theme.slint";
import { Appli, Ecran, Resultat } from "../etat.slint";
import { Titre, TitreSection, Etiquette, Paragraphe, Chiffres, Bouton, GenreBouton, Carte, Pastille, Confiance, EcranCourbe, Separateur, Format } from "../composants.slint";

component LigneZoneResultat inherits VerticalLayout {
    in property <string> nom;
    in property <string> plage;
    in property <float> gain;
    in property <bool> change;
    in property <int> confiance;
    in property <string> detail;
    spacing: 10px;
    Separateur { }
    HorizontalLayout {
        spacing: 14px;
        VerticalLayout {
            spacing: 2px;
            Text { text: nom; font-family: Theme.courant; font-weight: 700; font-size: 17px; color: Theme.texte; wrap: word-wrap; }
            Chiffres { text: plage; font-size: 14px; color: Theme.discret; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            min-width: 96px;
            Chiffres {
                text: change ? Format.db(gain) : @tr("inchangé");
                font-size: change ? 20px : 15px;
                color: change ? Theme.texte : Theme.discret;
                horizontal-alignment: right;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Confiance { niveau: confiance; }
        }
    }
    if detail != "": Paragraphe { text: detail; font-size: 14px; }
}

component Legende inherits HorizontalLayout {
    in property <string> texte;
    in property <color> couleur;
    in property <bool> tirets: false;
    spacing: 8px;
    horizontal-stretch: 0;
    VerticalLayout {
        alignment: center;
        Rectangle { width: 26px; height: 3px; background: couleur; opacity: tirets ? 0.7 : 1; }
    }
    Text { text: texte; font-family: Theme.courant; font-size: 14px; color: Theme.discret; vertical-alignment: center; }
}

export component EcranResultat inherits VerticalLayout {
    alignment: start;
    spacing: 24px;

    VerticalLayout {
        spacing: 10px;
        Titre { contenu: Resultat.disponible ? @tr("Ton résultat") : @tr("Résultat"); }
        if Resultat.disponible: Paragraphe { font-size: 18px; text: Resultat.resume; }
    }

    if !Resultat.disponible: Carte {
        remplissage: 30px;
        TitreSection { contenu: @tr("Pas encore de résultat"); }
        Paragraphe { text: @tr("Le résultat apparaît à la fin d’un test : la courbe avant et après, ce que tes oreilles ont choisi, zone par zone, et le degré de confiance."); }
        HorizontalLayout {
            alignment: start;
            Bouton { texte: @tr("Lancer un test"); genre: GenreBouton.principal; active => { Appli.aller(Ecran.tester); } }
        }
    }

    if Resultat.disponible: HorizontalLayout {
        spacing: 24px;
        // Colonne de gauche : la courbe puis le détail par zone.
        VerticalLayout {
            horizontal-stretch: 3;
            spacing: 24px;
            Carte {
                HorizontalLayout {
                    spacing: 14px;
                    Text { text: Resultat.titre.to-uppercase(); font-family: Theme.titres; font-weight: 700; font-size: 30px; color: Theme.texte; wrap: word-wrap; vertical-alignment: center; }
                    VerticalLayout { alignment: center; horizontal-stretch: 0; Confiance { niveau: Resultat.confiance; } }
                }
                EcranCourbe { courbe: Resultat.courbe-nouvelle; courbe-fond: Resultat.courbe-reference; min-height: 200px; }
                HorizontalLayout {
                    spacing: 24px;
                    alignment: start;
                    Legende { texte: @tr("Référence"); couleur: Theme.discret; tirets: true; }
                    Legende { texte: @tr("Nouvelle version"); couleur: Theme.a; }
                }
                Paragraphe { text: @tr("Préampli automatique : {}", Format.db(Resultat.preampli-db)); font-size: 14px; }
            }
            Carte {
                TitreSection { contenu: @tr("Ce que tes oreilles ont choisi"); }
                Paragraphe {
                    font-size: 14px;
                    text: @tr("Chaque niveau décrit une comparaison prise seule. Indice : elle peut être due au hasard. Probable : elle avait au plus 1 chance sur 4 de tomber ainsi par hasard. Sûr : moins de 6 %. Un test fait plusieurs comparaisons : ces niveaux ne garantissent pas qu’un changement est réel.");
                }
                if Resultat.zones.length == 0: Paragraphe { text: @tr("Aucune zone n’a encore été testée."); }
                for z in Resultat.zones: LigneZoneResultat {
                    nom: z.nom; plage: z.plage; gain: z.gain-db; change: z.change; confiance: z.confiance; detail: z.detail;
                }
                Separateur { }
                if Resultat.controles != "": Paragraphe { text: Resultat.controles; font-size: 15px; }
                if Resultat.verification != "": Paragraphe { text: Resultat.verification; font-size: 15px; }
                // Écart de volume mesuré sur ce qui jouait (ticket 26) : le bilan, puis les duels
                // qui dépassent le seuil, marqués comme un avertissement.
                if Resultat.volume != "": Paragraphe { text: Resultat.volume; font-size: 15px; }
                for e in Resultat.ecarts-volume: HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        Pastille { texte: e.ecart; couleur: Theme.fond-erreur; encre: Theme.erreur; taille: 14px; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: e.titre; font-family: Theme.courant; font-weight: 600; font-size: 15px; color: Theme.texte; wrap: word-wrap; }
                        Paragraphe { text: e.detail; font-size: 14px; }
                    }
                }
                if Resultat.applis.length > 0: VerticalLayout {
                    spacing: 6px;
                    Etiquette { contenu: @tr("Selon l’appli"); }
                    for a in Resultat.applis: HorizontalLayout {
                        spacing: 12px;
                        Text { text: a.nom; width: 140px; font-family: Theme.courant; font-weight: 600; font-size: 16px; color: Theme.texte; vertical-alignment: center; }
                        Paragraphe { text: @tr("{n} duel · {}" | "{n} duels · {}" % a.duels, a.preference); font-size: 14px; vertical-alignment: center; horizontal-alignment: left; }
                    }
                }
            }
        }
        // Colonne de droite : garder ce profil.
        VerticalLayout {
            horizontal-stretch: 2;
            min-width: 300px;
            alignment: start;
            Carte {
                TitreSection { contenu: @tr("Garder ce profil"); }
                if !Resultat.active && !Resultat.recommandee: Paragraphe {
                    text: @tr("Ce test ne donne pas de raison d’activer cette version : ta référence reste en place.");
                    font-size: 15px;
                }
                if !Resultat.active: Bouton {
                    texte: Resultat.recommandee ? @tr("Activer ce profil") : @tr("Activer quand même");
                    prefixe: "✓";
                    genre: Resultat.recommandee ? GenreBouton.principal : GenreBouton.secondaire;
                    active => { Resultat.activer(); }
                }
                if Resultat.active: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout { alignment: start; Pastille { texte: @tr("✓ Profil activé"); couleur: Theme.fond-ok; encre: Theme.ok; taille: 15px; } }
                    HorizontalLayout {
                        alignment: start;
                        Bouton { texte: @tr("Revenir à la référence"); genre: GenreBouton.lien; active => { Resultat.revenir-reference(); } }
                    }
                }
                Separateur { }
                Etiquette { contenu: @tr("Exporter pour un autre logiciel"); wrap: word-wrap; }
                GridLayout {
                    spacing: 10px;
                    Row {
                        Bouton { texte: "Peace"; active => { Resultat.exporter("peace"); } }
                        Bouton { texte: "Equalizer APO"; active => { Resultat.exporter("apo"); } }
                    }
                    Row {
                        Bouton { texte: "AutoEQ"; active => { Resultat.exporter("autoeq"); } }
                        Bouton { texte: "Wavelet"; active => { Resultat.exporter("wavelet"); } }
                    }
                }
                Separateur { }
                HorizontalLayout {
                    alignment: start;
                    Bouton { texte: @tr("Nouveau test"); active => { Resultat.nouveau-test(); } }
                }
            }
        }
    }
}
