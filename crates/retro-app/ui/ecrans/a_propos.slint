import { Theme } from "../theme.slint";
import { Titre, TitreSection, Paragraphe, Chiffres, Carte, Bouton, Separateur, Logo } from "../composants.slint";
import { Appli } from "../etat.slint";

component LigneLicence inherits HorizontalLayout {
    in property <string> nom;
    in property <string> licence;
    in property <string> role;
    spacing: 20px;
    min-height: 56px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        min-width: 300px;
        max-width: 300px;
        Text { text: nom; font-family: Theme.courant; font-weight: 700; font-size: 16px; color: Theme.texte; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        min-width: 170px;
        max-width: 170px;
        Chiffres { text: licence; font-size: 14px; color: Theme.discret; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        Text { text: role; font-family: Theme.courant; font-size: 14px; color: Theme.discret; wrap: word-wrap; }
    }
}

export component APropos inherits VerticalLayout {
    alignment: start;
    spacing: 24px;

    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Logo { taille: 96px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Titre { contenu: @tr("Retro EQ"); }
            Paragraphe { text: @tr("Version {} · logiciel libre sous licence GPLv3", Appli.version); font-size: 18px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Bouton { texte: @tr("Code source sur GitHub"); active => { Appli.ouvrir-lien("https://github.com/alexisdechiara/retro-eq"); } }
        }
    }

    Carte {
        TitreSection { contenu: @tr("Ta licence, en clair"); }
        Paragraphe { text: @tr("Tu peux utiliser Retro EQ pour tout, étudier son code, le modifier et le partager. Si tu partages une version modifiée, elle doit rester libre, sous la même licence, avec son code source."); }
        Paragraphe { text: @tr("Les mesures sont un point de départ : c’est ton oreille qui décide."); color: Theme.texte; }
    }

    Carte {
        TitreSection { contenu: @tr("Composants libres utilisés"); }
        Separateur { }
        LigneLicence { nom: "Slint"; licence: "GPLv3"; role: @tr("Interface de l’appli"); }
        Separateur { }
        LigneLicence { nom: "Equalizer APO"; licence: "GPLv2"; role: @tr("Moteur audio, installé à côté de Retro EQ et non inclus dans le code de l’appli"); }
        Separateur { }
        LigneLicence { nom: "Antonio, Libre Franklin, DM Mono, Anton"; licence: "SIL OFL"; role: @tr("Polices de l’interface (SIL Open Font License)"); }
        Separateur { }
        LigneLicence { nom: @tr("Bibliothèques Rust"); licence: "MIT / Apache-2.0"; role: @tr("Son, calculs, fichiers : la liste complète est dans le code source"); }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Bouton { texte: @tr("Site de Slint"); active => { Appli.ouvrir-lien("https://slint.dev"); } }
            Bouton { texte: @tr("Site d’Equalizer APO"); active => { Appli.ouvrir-lien("https://sourceforge.net/projects/equalizerapo/"); } }
        }
    }
}
