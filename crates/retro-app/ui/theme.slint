    out property <color> discret: #C2B8A3;
    out property <color> trait: #3E434B;
    out property <color> ambre: #F3A712;
    out property <color> sur-ambre: #1B1E22;
    out property <color> rouille: #C4461F;
    out property <color> jaune: #FFD23F;
    out property <color> bleu: #3D7EA6;
    out property <color> a: #2AB7A9;
    out property <color> sur-a: #0E1F1D;
    out property <color> b: #FF8A1F;
    out property <color> sur-b: #1B1E22;
    out property <color> ok: #7BD389;
